# --- Connection -------------------------------------------------------------
# Base URL of the Ossian installation.
OSSIAN_URL=http://localhost:8081
# API key (osk_…). Issue one from the Ossian console (Console → API keys) and give
# it the narrowest role/namespace that works. Required.
OSSIAN_API_KEY=
# Request timeout in milliseconds.
OSSIAN_TIMEOUT_MS=120000
# Separates one agent's memories from another's. Two agents sharing an id share
# their recollections — occasionally what you want, usually not.
OSSIAN_AGENT_ID=mcp

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
#   read-only  → ask_documents, list_namespaces, list_documents, recall
#   read-write → adds add_document_from_url, remember
#   admin      → adds forget_session (also needs OSSIAN_ALLOW_FORGET=true)
OSSIAN_MODE=read-only
# Comma-separated namespace allowlist. Empty = all.
OSSIAN_NAMESPACE_ALLOWLIST=
# Namespaces that can be read/searched but never ingested into.
OSSIAN_PROTECTED_NAMESPACES=
# forget_session erases memory irreversibly; require this in addition to admin mode.
OSSIAN_ALLOW_FORGET=false
# Validate + log writes (ingest / remember / forget) without executing them.
OSSIAN_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
OSSIAN_AUDIT_LOG=true
